# Server
PORT=3001
HOST=127.0.0.1

# Browser / stealth
# Use "chrome" to drive your installed Google Chrome (more stealthy),
# or "chromium" to use Playwright's bundled browser.
BROWSER_CHANNEL=chrome
# Path to the persistent profile folder (relative to project root).
USER_DATA_DIR=auth
# Run the browser without a visible window. Keep false for FB reliability.
HEADLESS=false

# Automation pacing (milliseconds)
ACTION_DELAY_MIN=700
ACTION_DELAY_MAX=2200
BETWEEN_GROUP_DELAY_MIN=120000
BETWEEN_GROUP_DELAY_MAX=300000

# Screenshots on failure go here
SCREENSHOT_DIR=logs