{
  "name": "fb-autopost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local headed-Playwright Facebook group autoposter with a React WebGUI.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node --watch src/server/index.js\" \"vite\"",
    "dev:server": "node --watch src/server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/index.js",
    "login": "node src/automation/login.js",
    "post": "node src/automation/run.js",
    "post:dry": "node src/automation/run.js --dry-run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.48.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.8"
  }
}